# Copy to .env and fill in. .env is gitignored and must stay that way.

# SEC EDGAR requires a descriptive User-Agent with a contact address
SEC_USER_AGENT="your name your@email.com"

# Optional, only if a collector needs authenticated access
OPENROUTER_API_KEY=
FRED_API_KEY=

# Artificial Analysis data API, free tier with attribution. Used to broaden the
# capability index beyond the thin slice OpenRouter embeds. Get a key at
# https://artificialanalysis.ai/data-api
ARTIFICIAL_ANALYSIS_API_KEY=

# Local data layer
DATABASE_PATH=data/research.db
